<?php

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
function webform_geonames_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Attach the city autocomplete on both the add and edit submission forms of
  // organisation_registry (editing is where a stale manual city would slip in).
  $target_forms = [
    'webform_submission_organisation_registry_add_form',
    'webform_submission_organisation_registry_edit_form',
  ];
  if (in_array($form_id, $target_forms, TRUE)) {
    if (!isset($form['#attached']['library']) || !is_array($form['#attached']['library'])) {
      $form['#attached']['library'] = [];
    }
    $form['#attached']['library'][] = 'webform_geonames/autocomplete';
    // Debug only, and gated to these forms: core dblog has no severity threshold,
    // so logging outside this block would write to watchdog on every form build
    // site-wide and evict the real warnings/errors under the default row_limit.
    \Drupal::logger('webform_geonames')->debug('Attached webform_geonames/autocomplete to @form_id.', ['@form_id' => $form_id]);
  }
}
